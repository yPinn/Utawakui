{
  "permissions": {
    "allow": [
      "Bash(rtk grep *)",
      "Bash(rtk prettier *)",
      "Bash(rtk lint *)",
      "Bash(rtk git *)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(npm update *)",
      "Bash(npm install *)",
      "Bash(git --no-pager diff *)"
    ]
  },
  "enabledPlugins": {
    "gsap-skills@gsap-skills": true,
    "vue-skills-bundle@vue-skills": true
  },
  "extraKnownMarketplaces": {
    "gsap-skills": {
      "source": {
        "source": "github",
        "repo": "greensock/gsap-skills"
      }
    },
    "vue-skills": {
      "source": {
        "source": "github",
        "repo": "vuejs-ai/skills"
      }
    }
  }
}
