# Keep repository text files stable across Windows/macOS/Linux.
* text=auto eol=lf

# Windows command scripts are the only text files that should keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and packaged/runtime artifacts must never be line-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.bmp binary

*.mp3 binary
*.m4a binary
*.wav binary
*.flac binary
*.ogg binary
*.opus binary
*.webm binary
*.mp4 binary
*.mov binary

*.asar binary
*.blockmap binary
*.dll binary
*.dylib binary
*.exe binary
*.node binary
*.onnx binary
*.so binary
*.zip binary
*.7z binary
*.gz binary
*.tgz binary
