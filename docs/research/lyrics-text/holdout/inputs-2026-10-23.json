      "text": "Written by Nobody",
      "source": {
        "documentId": "6134ee8deedaa728",
        "startMs": 12000,
        "endMs": 20000
      }
    },
    {
      "lineId": "ca186b41a5b91342",
      "language": "en",
      "text": "Written by Nobody",
      "source": {
        "documentId": "47c6c8d0ccd0cdc8",
