{
  "name": "utawakui",
  "version": "0.5.1",
  "description": "Local-first desktop media and OBS companion",
  "author": "llazyPilot Studio",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "npm@11.12.1",
  "main": "electron/entry.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dev:tools": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev --devtools\"",
    "build": "vite build",
    "build:runtime": "node scripts/build-release-runtime.mjs",
    "electron:install": "install-electron",
    "start": "npm run build && electron .",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:release": "npm run build && electron-builder --win nsis --x64 --publish never --config.win.signExecutable=true",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#.benchmarks\" \"#dist\" \"#coverage\" \"#release\" \"#release-*\" \"#tasks\" \"#.tmp\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:settings-layout": "npm run build && node scripts/settings-window-layout-probe.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/coverageRatchet.js",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "prepare": "husky",
    "i18n:baseline": "node scripts/uiLiteralRatchet.js --write",
    "license:inventory": "node scripts/license-inventory.mjs",
    "license:write": "node scripts/third-party-notices.mjs --write",
    "license:verify": "node scripts/third-party-notices.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "audit:runtime": "node scripts/runtime-dependency-osv-cli.mjs",
    "perf:startup": "node scripts/startup-performance.mjs",
    "output:baseline": "node scripts/outputAppearanceBaseline.mjs",
    "output:audit": "node scripts/output-appearance-audit.mjs",
    "analysis:benchmark-real": "node scripts/music-analysis-real-song-benchmark.mjs",
    "analysis:evaluate-bpm": "node scripts/music-analysis-bpm-evaluation.mjs",
    "analysis:evaluate": "node scripts/music-analysis-evaluation.mjs",
    "lyrics:evaluate-providers": "node scripts/lyrics-provider-corpus-cli.mjs",
    "lyrics:contracts": "node scripts/lyrics-provider-contract-cli.mjs",
    "lyrics:evaluate-readings": "node scripts/lyrics-reading-evaluation.mjs",
    "lyrics:prepare-reading-corpus": "node scripts/lyrics-reading-local-corpus.mjs",
    "lyrics:review-readings": "node scripts/lyrics-reading-review-cli.mjs",
    "lyrics:prepare-provider-corpus": "node scripts/lyrics-provider-corpus-prepare-cli.mjs",
    "lyrics:review-provider-corpus": "node scripts/lyrics-provider-corpus-review-cli.mjs",
    "release:verify-version": "node scripts/release-contract-cli.mjs version",
    "release:verify-artifacts": "node scripts/release-contract-cli.mjs artifacts",
    "release:verify-installed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-installed-acceptance.ps1"
  },
  "lint-staged": {
    "*.{cjs,js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@lucide/vue": "^1.29.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "adm-zip": "0.6.1",
    "concurrently": "^10.0.4",
    "electron": "^43.7.8",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.6",
    "rolldown": "1.2.15",
    "semver": "^7.8.5",
    "signalsmith-stretch": "^1.3.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.12",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.16",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@intlify/core-base": "^11.4.16",
    "@napolab/texture-bridge-core": "0.15.0",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "gsap": "^3.13.0",
    "js-yaml": "5.4.3",
    "kissfft-js": "^0.1.8",
    "koroman": "^1.0.16",
    "kuromoji": "^0.1.2",
    "music-metadata": "12.2.0",
    "obs-websocket-js": "^5.0.8",
    "onnxruntime-node": "^1.30.0",
    "opencc-js": "1.4.2",
    "sax": "^1.6.1",
    "wanakana": "^5.3.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.2"
    },
    "smol-toml": "1.9.0",
    "shell-quote": "^1.12.0"
  }
}
