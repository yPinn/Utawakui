      "activation": "explicit-selection"
    },
    "fontScale": {
      "level": "default",
      "scope": "slot-template",
      "activation": "template-default"
    },
    "fontWeight": {
      "level": "opt",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "surface": {
      "level": "opt",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "spacingDensity": {
      "level": "opt",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
