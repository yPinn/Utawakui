{
  "version": 1,
  "appearanceSchemaVersion": 6,
  "captureSizes": {
    "small": {
      "width": 480,
      "height": 270
    },
    "medium": {
      "width": 480,
      "height": 540
    },
    "large": {
      "width": 480,
      "height": 810
    },
    "full": {
      "width": 1920,
      "height": 1080
    }
  },
  "interpretation": {
    "default": "Baseline control and initial value; does not mean all controls are initially visible",
    "opt": "Explicit selection; existing default remains active until changed",
    "advanced": "Bounded artistic-role override; only where a verified consumer exists"
  },
  "fieldPolicy": {
    "paletteId": {
      "level": "opt",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "lookAmount": {
