    },
    "kineticArrangement": {
      "level": "opt",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "textColor": {
      "level": "advanced",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "accentColor": {
      "level": "advanced",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "positionAnchor": {
      "level": "opt",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "positionOffsetX": {
      "level": "advanced",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "positionOffsetY": {
      "level": "advanced",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
    "contrastStyle": {
      "level": "opt",
      "scope": "slot-template",
      "activation": "explicit-selection"
    },
