uniform float4x4 ViewProj;
uniform texture2d image;
uniform int mode;
uniform float strength;
uniform float effect_time;
uniform float direction;

sampler_state linear_clamp {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct Vertex {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

Vertex pass_vertex(Vertex v) {
    v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    return v;
}

float noise_value(float2 p) {
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 camera_effect(Vertex v) : TARGET {
    float2 uv = v.uv;
    if (mode == 1) {
        float2 pivot = float2(0.5, 0.52);
        float zoom = 1.0 + 0.19 * strength * direction;
        return image.Sample(linear_clamp, pivot + (uv - pivot) / zoom);
    }
    if (mode == 2) {
        float phase = floor(effect_time * 13.0);
        float row = floor(uv.y * 26.0);
        float band = noise_value(float2(row, phase + 5.0));
        float tear = step(0.64, band) * (band - 0.81) * strength * 0.31;
        float split = strength * (0.004 + 0.008 * step(0.64, band));
        uv.x += tear;
        float4 middle = image.Sample(linear_clamp, uv);
        float4 red = image.Sample(linear_clamp, uv + float2(split, 0.0));
        float4 blue = image.Sample(linear_clamp, uv - float2(split, 0.0));
        return float4(min(red.r, middle.a), middle.g, min(blue.b, middle.a), middle.a);
    }
    float4 original = image.Sample(linear_clamp, uv);
    float tick = floor(effect_time * 12.0);
    float2 cell = floor(uv * float2(790.0, 445.0));
    float2 grain_cell = cell + tick * float2(3.0, 13.0);
    float grain = noise_value(grain_cell) - 0.5;
    float2 chroma_cell = floor(cell / 2.0) + tick * float2(5.0, 11.0);
    float warm = noise_value(chroma_cell + 17.0) - 0.5;
    float cool = noise_value(chroma_cell + 49.0) - 0.5;
    float3 chroma = float3(warm, -0.46 * (warm + cool), cool);
    float scan_row = floor(uv.y * 400.0);
    float scan = noise_value(float2(scan_row, tick)) - 0.5;
    float scanline = frac(scan_row * 0.5) - 0.25;
    float3 color = original.rgb + (grain * 0.25 + scan * 0.048 + scanline * 0.063 + chroma * 0.14) * strength * original.a;
    return float4(clamp(color, 0.0, original.a), original.a);
}

technique Draw {
    pass {
        vertex_shader = pass_vertex(v);
        pixel_shader = camera_effect(v);
    }
}
