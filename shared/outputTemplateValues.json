{
  "version": 1,
  "slots": [
    {
      "id": "setlist",
      "label": "歌單",
      "path": "/overlay/setlist",
      "defaultTemplateId": "queue-board",
      "defaultStyleSetIds": ["runtime-source", "setlist-layout"]
    },
    {
      "id": "lyrics",
      "label": "歌詞",
      "path": "/overlay/lyrics",
      "defaultTemplateId": "focus-line",
      "defaultStyleSetIds": ["runtime-source", "lyrics-type"]
    },
    {
      "id": "now-playing",
      "label": "播放中",
      "path": "/overlay/now-playing",
      "defaultTemplateId": "now-next",
      "defaultStyleSetIds": ["runtime-source"]
    }
  ],
  "templateKinds": {
    "now-next": "now-playing",
    "queue-board": "setlist",
    "focus-line": "lyrics",
    "quiet-caption": "lyrics",
    "karaoke-stack": "lyrics",
    "kinetic-pop": "lyrics",
    "live-stage": "lyrics",
    "manga-frame": "lyrics",
    "reading-aid": "lyrics",
    "art-card": "now-playing",
    "cover-player": "now-playing"
  },
  "templateCaptureSizes": {
    "now-next": { "default": "small", "supported": ["small"] },
    "queue-board": { "default": "large", "supported": ["large"] },
    "focus-line": { "default": "full", "supported": ["full"] },
    "quiet-caption": { "default": "full", "supported": ["full"] },
    "karaoke-stack": { "default": "full", "supported": ["full"] },
    "kinetic-pop": { "default": "full", "supported": ["full"] },
    "live-stage": { "default": "full", "supported": ["full"] },
    "manga-frame": { "default": "full", "supported": ["full"] },
    "reading-aid": { "default": "full", "supported": ["full"] },
    "art-card": { "default": "small", "supported": ["small"] },
    "cover-player": { "default": "medium", "supported": ["medium"] }
  }
}
