{
  "version": 1,
  "slots": [
    {
      "id": "lyrics",
      "path": "/overlay/lyrics",
      "defaultTemplateId": "karaoke-stack",
      "defaultStyleSetIds": ["runtime-source", "lyrics-type"]
    },
    {
      "id": "setlist",
      "path": "/overlay/setlist",
      "defaultTemplateId": "receipt-setlist",
      "defaultStyleSetIds": ["runtime-source", "setlist-layout"]
    },
    {
      "id": "now-playing",
      "path": "/overlay/now-playing",
      "defaultTemplateId": "art-card",
      "defaultStyleSetIds": ["runtime-source"]
    }
  ],
  "templateKinds": {
    "queue-board": "setlist",
    "karaoke-stack": "lyrics",
    "kinetic-pop": "lyrics",
    "ornate-vertical": "lyrics",
    "chalkboard-vertical": "lyrics",
    "centered-vertical": "lyrics",
    "live-stage": "lyrics",
    "manga-frame": "lyrics",
    "art-card": "now-playing",
    "ticket-stub": "now-playing",
    "cover-player": "now-playing",
    "receipt-setlist": "setlist",
    "ribbon-setlist": "setlist",
    "fisheye-lens": "lyrics"
  },
  "templateCaptureSizes": {
    "receipt-setlist": {
      "default": "large",
      "supported": ["large"]
    },
    "ribbon-setlist": {
      "default": "large",
      "supported": ["large"]
    },
    "queue-board": {
      "default": "large",
      "supported": ["large"]
    },
    "karaoke-stack": {
      "default": "full",
      "supported": ["full"]
    },
    "kinetic-pop": {
      "default": "full",
      "supported": ["full"]
    },
    "ornate-vertical": {
      "default": "full",
      "supported": ["full"]
    },
    "centered-vertical": {
      "default": "full",
      "supported": ["full"]
    },
    "chalkboard-vertical": {
      "default": "full",
      "supported": ["full"]
    },
    "live-stage": {
      "default": "full",
      "supported": ["full"]
    },
    "manga-frame": {
      "default": "full",
      "supported": ["full"]
    },
    "art-card": {
      "default": "small",
      "supported": ["small"]
    },
    "ticket-stub": {
      "default": "small",
      "supported": ["small"]
    },
    "fisheye-lens": {
      "default": "full",
      "supported": ["full"]
    },
    "cover-player": {
      "default": "portrait",
      "supported": ["portrait", "portrait-large"]
    }
  }
}
