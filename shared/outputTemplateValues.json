{
  "version": 1,
  "slots": [
    {
      "id": "lyrics",
      "label": "歌詞",
      "path": "/overlay/lyrics",
      "defaultTemplateId": "karaoke-stack",
      "defaultStyleSetIds": ["runtime-source", "lyrics-type"]
    },
    {
      "id": "setlist",
      "label": "歌單",
      "path": "/overlay/setlist",
      "defaultTemplateId": "queue-board",
      "defaultStyleSetIds": ["runtime-source", "setlist-layout"]
    },
    {
      "id": "now-playing",
      "label": "播放中",
      "path": "/overlay/now-playing",
      "defaultTemplateId": "art-card",
      "defaultStyleSetIds": ["runtime-source"]
    }
  ],
  "templateKinds": {
    "queue-board": "setlist",
    "karaoke-stack": "lyrics",
    "kinetic-pop": "lyrics",
    "ornate-vertical": "lyrics",
    "live-stage": "lyrics",
    "manga-frame": "lyrics",
    "art-card": "now-playing",
    "cover-player": "now-playing"
  },
  "templateCaptureSizes": {
    "queue-board": {
      "default": "large",
      "supported": ["large"]
    },
    "karaoke-stack": {
      "default": "full",
      "supported": ["full"]
    },
    "kinetic-pop": {
      "default": "full",
      "supported": ["full"]
    },
    "ornate-vertical": {
      "default": "full",
      "supported": ["full"]
    },
    "live-stage": {
      "default": "full",
      "supported": ["full"]
    },
    "manga-frame": {
      "default": "full",
      "supported": ["full"]
    },
    "art-card": {
      "default": "small",
      "supported": ["small"]
    },
    "cover-player": {
      "default": "medium",
      "supported": ["medium"]
    }
  }
}
